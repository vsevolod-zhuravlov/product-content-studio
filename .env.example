# Host port published by docker compose for Postgres (container port stays 5432).
# If 5432 is already in use on the host, set this to a free port (e.g. 55432).
# DATABASE_URL and TEST_DATABASE_URL must use the same host port.
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/product_content_studio?schema=public"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/product_content_studio_test?schema=public"
JWT_SECRET="change-me-to-a-secret-at-least-32-characters-long"
# For local HTTP only. Omit on HTTPS production so the session cookie is Secure.
AUTH_COOKIE_SECURE="false"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
